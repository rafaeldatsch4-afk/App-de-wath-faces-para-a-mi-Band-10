<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para backup nem para transferência entre aparelhos: a auth key fica só neste celular
     (e a chave do Keystore que a protege não sai dele mesmo). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
