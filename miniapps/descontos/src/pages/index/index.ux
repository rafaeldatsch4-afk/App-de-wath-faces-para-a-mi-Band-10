<template>
  <div class="page">
    <!-- Teclado: primeiro o preço original, depois o desconto. Só div/text/if/for, como no Juros. -->
    <div class="tela" if="{{telaTeclado}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="{{digitadoCls}}">{{mostrado}}</text>
        <text class="{{avisoCls}}">{{aviso}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="{{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">{{cancelarTexto}}</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado: cabe numa tela só -->
    <div class="tela centro" if="{{telaResultado}}">
      <text class="{{tituloResultadoCls}}">{{tituloResultado}}</text>
      <text class="{{precoCls}}">{{preco}}</text>
      <div class="espaco"></div>
      <text class="legenda">Você paga</text>
      <text class="{{totalCls}}">{{total}}</text>
      <div class="espaco"></div>
      <text class="legenda">Você economiza</text>
      <text class="{{economiaCls}}">{{economia}}</text>
      <div class="espaco"></div>
      <div class="botoes">
        <div class="botao cinza" onclick="voltar">
          <text class="textoBotaoClaro">Voltar</text>
        </div>
        <div class="botao verde" onclick="novaConta">
          <text class="textoBotaoEscuro">Nova</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { CAMPOS, calcular, digitar, mostrarRascunho, paraNumero, porcento, reais, validar } from '../../common/descontos.js'

// Só padrões do Juros, que já rodou na Mi Band 10: div/text com if e for, propriedades simples
// no template (sem índice de lista nem expressão) e classes montadas aqui. Nada de list.

function k(t, key, cls) {
  return { t: t, k: key, cls: 'tecla ' + cls }
}

var TECLAS = [
  [k('1', '1', ''), k('2', '2', ''), k('3', '3', '')],
  [k('4', '4', ''), k('5', '5', ''), k('6', '6', '')],
  [k('7', '7', ''), k('8', '8', ''), k('9', '9', '')],
  [k(',', ',', 'fn'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]
]

// Maior letra (classe .fNN) em que o texto cabe em [largura] px. Cada caractere ocupa até
// ~0,62 da altura da letra (medido com uma fonte mais larga que a da banda, por segurança).
var FONTES = [40, 36, 32, 28, 24, 22, 20, 18, 16]
function fonte(texto, maximo, largura) {
  for (var i = 0; i < FONTES.length; i++) {
    var f = FONTES[i]
    if (f <= maximo && texto.length * f * 0.62 <= largura) return 'f' + f
  }
  return 'f16'
}

// Largura útil: tela 212 − 2×10 de margem.
var LARGURA_TELA = 192

export default {
  private: {
    telaTeclado: true,
    telaResultado: false,
    // Textos confirmados de cada campo ('' = ainda não preenchido).
    textos: ['', ''],
    // Teclado (o app abre direto no preço original)
    campo: 0,
    rascunho: '',
    titulo: 'Preço original',
    mostrado: 'R$ 0',
    digitadoCls: 'digitado f40',
    aviso: '1 de 2 · em reais',
    avisoCls: 'dica f18',
    cancelarTexto: 'Sair',
    teclas: TECLAS,
    // Resultado
    tituloResultado: '',
    tituloResultadoCls: 'tituloResultado f24',
    preco: '',
    precoCls: 'preco f20',
    total: '',
    totalCls: 'total f36',
    economia: '',
    economiaCls: 'linhaValor f32'
  },

  mostrar(tela) {
    this.telaTeclado = tela === 'teclado'
    this.telaResultado = tela === 'resultado'
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(CAMPOS[this.campo].id, this.rascunho)
    this.mostrado = texto
    this.digitadoCls = 'digitado ' + fonte(texto, 40, LARGURA_TELA)
  },

  mostrarAviso(erro) {
    this.aviso = erro ? erro : CAMPOS[this.campo].dica
    this.avisoCls = (erro ? 'erro ' : 'dica ') + fonte(this.aviso, 18, LARGURA_TELA)
  },

  abrir(indice) {
    this.campo = indice
    this.rascunho = this.textos[indice]
    this.titulo = CAMPOS[indice].titulo
    this.cancelarTexto = indice === 0 ? 'Sair' : 'Voltar'
    this.mostrarAviso('')
    this.atualizarTeclado()
    this.mostrar('teclado')
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, CAMPOS[this.campo])
    this.mostrarAviso('')
    this.atualizarTeclado()
  },

  confirmar() {
    var erro = validar(CAMPOS[this.campo].id, paraNumero(this.rascunho))
    if (erro) {
      this.mostrarAviso(erro)
      return
    }
    // Cópia da lista para a tela perceber a mudança.
    var textos = this.textos.slice()
    textos[this.campo] = this.rascunho
    this.textos = textos
    if (this.campo === 0) {
      this.abrir(1)
    } else {
      this.calcularConta()
    }
  },

  // No preço original, "Sair" fecha o app; no desconto, "Voltar" volta ao preço.
  cancelar() {
    if (this.campo === 0) {
      this.$app.exit()
    } else {
      this.abrir(0)
    }
  },

  calcularConta() {
    var preco = paraNumero(this.textos[0])
    var desconto = paraNumero(this.textos[1])
    var r = calcular(preco, desconto)
    this.tituloResultado = 'Desconto de ' + porcento(desconto)
    this.tituloResultadoCls = 'tituloResultado ' + fonte(this.tituloResultado, 24, LARGURA_TELA)
    this.preco = 'De ' + reais(preco)
    this.precoCls = 'preco ' + fonte(this.preco, 20, LARGURA_TELA)
    this.total = reais(r.final)
    this.totalCls = 'total ' + fonte(this.total, 36, LARGURA_TELA)
    this.economia = reais(r.desconto)
    this.economiaCls = 'linhaValor ' + fonte(this.economia, 32, LARGURA_TELA)
    this.mostrar('resultado')
  },

  // Volta para o desconto, com os números, para trocar a porcentagem.
  voltar() {
    this.abrir(1)
  },

  novaConta() {
    this.textos = ['', '']
    this.abrir(0)
  },

  // Gesto de voltar da banda: resultado → desconto; desconto → preço; no preço, fecha o app.
  // Mesmo padrão de uma calculadora que já roda na Mi Band 10 (sempre retorna true e sai com
  // this.$app.exit()).
  onBackPress() {
    if (this.telaResultado) {
      this.abrir(1)
    } else if (this.campo === 1) {
      this.abrir(0)
    } else {
      this.$app.exit()
    }
    return true
  }
}
</script>

<style>
/* Letras grandes e tudo cabendo na tela (212 × 520), sem rolar. */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 36px 10px 30px 10px;
}

.tela {
  flex: 1;
  flex-direction: column;
}

.centro {
  align-items: center;
}

.espaco {
  flex: 1;
}

.verde { background-color: #30d158; }
.cinza { background-color: #3a3a3c; }

/* Teclado */
.topo {
  height: 124px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 22px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 8px;
  text-align: center;
}

.dica {
  color: #8a8a8e;
  margin-top: 4px;
  text-align: center;
}

.erro {
  color: #ff453a;
  margin-top: 4px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }

.rotuloTecla {
  font-size: 36px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 19px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.tituloResultado {
  color: #ff9f0a;
  text-align: center;
}

.preco {
  color: #c7c7cc;
  text-align: center;
  margin-top: 6px;
}

.legenda {
  font-size: 19px;
  color: #8a8a8e;
}

.total {
  color: #30d158;
  font-weight: bold;
  text-align: center;
  margin-top: 4px;
}

.linhaValor {
  color: #ffffff;
  text-align: center;
  margin-top: 4px;
}

.botoes {
  flex-direction: row;
  width: 100%;
}

.botao {
  flex: 1;
  height: 64px;
  margin: 0 3px;
  border-radius: 32px;
  justify-content: center;
  align-items: center;
}

.textoBotaoEscuro {
  font-size: 26px;
  color: #000000;
  font-weight: bold;
}

.textoBotaoClaro {
  font-size: 24px;
  color: #ffffff;
}

/* Tamanhos de letra escolhidos no script conforme o texto (função fonte). */
.f40 { font-size: 40px; }
.f36 { font-size: 36px; }
.f32 { font-size: 32px; }
.f28 { font-size: 28px; }
.f24 { font-size: 24px; }
.f22 { font-size: 22px; }
.f20 { font-size: 20px; }
.f18 { font-size: 18px; }
.f16 { font-size: 16px; }
</style>
