<template>
  <div class="page">
    <!-- Tela 1: Valor e Parcelas. Só div/text/if/for, como na versão 1.0.0 que rodou na banda. -->
    <div class="tela" if="{{tela1}}">
      <text class="cabecalho">Juros · 1 de 2</text>
      <div class="barra" onclick="abrirValor">
        <text class="rotulo">Valor</text>
        <text class="{{valorCls}}">{{valorTexto}}</text>
      </div>
      <div class="barra" onclick="abrirParcelas">
        <text class="rotulo">Parcelas (vezes)</text>
        <text class="{{parcelasCls}}">{{parcelasTexto}}</text>
      </div>
      <div class="espaco"></div>
      <div class="botaoGrande laranja" onclick="irTela2">
        <text class="textoBotaoEscuro">Próximo ›</text>
      </div>
    </div>

    <!-- Tela 2: Tipo de juros, Taxa e Calcular -->
    <div class="tela" if="{{tela2}}">
      <div class="cabecalhoToque" onclick="irTela1">
        <text class="cabecalho">‹ Juros · 2 de 2</text>
      </div>
      <div class="barraTipo">
        <text class="rotulo">Tipo de juros</text>
        <div class="{{simplesCls}}" onclick="escolherSimples">
          <text class="{{simplesTextoCls}}">Simples</text>
        </div>
        <div class="{{compostoCls}}" onclick="escolherComposto">
          <text class="{{compostoTextoCls}}">Composto</text>
        </div>
      </div>
      <div class="barra" onclick="abrirTaxa">
        <text class="rotulo">Taxa ao mês (%)</text>
        <text class="{{taxaCls}}">{{taxaTexto}}</text>
      </div>
      <div class="espaco"></div>
      <div class="{{calcularCls}}" onclick="calcularConta">
        <text class="{{calcularTextoCls}}">{{calcularTexto}}</text>
      </div>
    </div>

    <!-- Teclado de um campo -->
    <div class="tela" if="{{telaTeclado}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="{{digitadoCls}}">{{mostrado}}</text>
        <text class="{{avisoCls}}">{{aviso}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="{{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">Cancelar</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado: cabe numa tela só -->
    <div class="tela centro" if="{{telaResultado}}">
      <text class="{{tituloResultadoCls}}">{{tituloResultado}}</text>
      <text class="{{resumo1Cls}}">{{resumo1}}</text>
      <text class="{{resumo2Cls}}">{{resumo2}}</text>
      <text class="legenda">Total a pagar</text>
      <text class="{{totalCls}}">{{total}}</text>
      <text class="legenda">Juros</text>
      <text class="{{jurosCls}}">{{juros}}</text>
      <text class="legenda">{{legendaParcela}}</text>
      <text class="{{parcelaCls}}">{{parcela}}</text>
      <div class="espaco"></div>
      <div class="botoes">
        <div class="botao cinza" onclick="voltar">
          <text class="textoBotaoClaro">Voltar</text>
        </div>
        <div class="botao verde" onclick="novaConta">
          <text class="textoBotaoEscuro">Nova</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { CAMPOS, calcular, digitar, mostrarCampo, mostrarRascunho, paraNumero, porcento, reais, validar } from '../../common/juros.js'

// Só padrões da versão 1.0.0, que rodou na Mi Band 10: div/text com if e for, propriedades simples
// no template (sem índice de lista nem expressão) e classes montadas aqui. A 1.1.0 usou o
// componente list para rolar a tela e ficou com a tela preta na banda: nada de list aqui.

function k(t, key, cls) {
  return { t: t, k: key, cls: 'tecla ' + cls }
}

var NUMEROS = [
  [k('1', '1', ''), k('2', '2', ''), k('3', '3', '')],
  [k('4', '4', ''), k('5', '5', ''), k('6', '6', '')],
  [k('7', '7', ''), k('8', '8', ''), k('9', '9', '')]
]
var TECLAS_DECIMAIS = NUMEROS.concat([[k(',', ',', 'fn'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])
// Parcelas não têm vírgula: a tecla fica apagada.
var TECLAS_INTEIRAS = NUMEROS.concat([[k('', '', 'apagada'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])

var VAZIO = 'Tocar aqui'

// Maior letra (classe .fNN) em que o texto cabe em [largura] px. Cada caractere ocupa até
// ~0,62 da altura da letra (medido com uma fonte mais larga que a da banda, por segurança).
var FONTES = [40, 36, 32, 28, 24, 22, 20, 18, 16]
function fonte(texto, maximo, largura) {
  for (var i = 0; i < FONTES.length; i++) {
    var f = FONTES[i]
    if (f <= maximo && texto.length * f * 0.62 <= largura) return 'f' + f
  }
  return 'f16'
}

// Larguras úteis: tela 212 − 2×10 de margem; barras têm mais 2×12 por dentro.
var LARGURA_TELA = 192
var LARGURA_BARRA = 168

function clsBarra(texto) {
  return 'valor ' + fonte(texto, 32, LARGURA_BARRA)
}

export default {
  private: {
    tela1: true,
    tela2: false,
    telaTeclado: false,
    telaResultado: false,
    // Tela de onde o teclado foi aberto, para voltar para ela.
    origem: 'tela1',
    // Textos confirmados de cada campo ('' = ainda não preenchido).
    textos: ['', '', ''],
    valorTexto: VAZIO,
    valorCls: 'vazio',
    parcelasTexto: VAZIO,
    parcelasCls: 'vazio',
    taxaTexto: VAZIO,
    taxaCls: 'vazio',
    pronto: false,
    calcularCls: 'botaoGrande off',
    calcularTextoCls: 'textoBotaoOff',
    calcularTexto: 'Preencha tudo',
    tipo: 'composto',
    simplesCls: 'op',
    simplesTextoCls: 'opTexto',
    compostoCls: 'op sel',
    compostoTextoCls: 'opTextoSel',
    // Teclado
    campo: 0,
    rascunho: '',
    titulo: '',
    mostrado: '',
    digitadoCls: 'digitado f40',
    aviso: '',
    avisoCls: 'dica f18',
    teclas: TECLAS_DECIMAIS,
    // Resultado
    tituloResultado: '',
    tituloResultadoCls: 'tituloResultado f24',
    resumo1: '',
    resumo1Cls: 'resumo f20',
    resumo2: '',
    resumo2Cls: 'resumo f20',
    total: '',
    totalCls: 'total f36',
    juros: '',
    jurosCls: 'linhaValor f28',
    legendaParcela: 'Cada parcela',
    parcela: '',
    parcelaCls: 'linhaValor f28'
  },

  mostrar(tela) {
    this.tela1 = tela === 'tela1'
    this.tela2 = tela === 'tela2'
    this.telaTeclado = tela === 'teclado'
    this.telaResultado = tela === 'resultado'
  },

  textoBarra(indice) {
    var texto = this.textos[indice]
    return texto === '' ? VAZIO : mostrarCampo(CAMPOS[indice].id, paraNumero(texto))
  },

  atualizarCampos() {
    var t = this.textos
    this.valorTexto = this.textoBarra(0)
    this.valorCls = t[0] === '' ? 'vazio' : clsBarra(this.valorTexto)
    this.parcelasTexto = this.textoBarra(1)
    this.parcelasCls = t[1] === '' ? 'vazio' : clsBarra(this.parcelasTexto)
    this.taxaTexto = this.textoBarra(2)
    this.taxaCls = t[2] === '' ? 'vazio' : clsBarra(this.taxaTexto)
    this.pronto = t[0] !== '' && t[1] !== '' && t[2] !== ''
    this.calcularCls = this.pronto ? 'botaoGrande verde' : 'botaoGrande off'
    this.calcularTextoCls = this.pronto ? 'textoBotaoEscuro' : 'textoBotaoOff'
    this.calcularTexto = this.pronto ? 'Calcular' : 'Preencha tudo'
  },

  atualizarTipo() {
    var simples = this.tipo === 'simples'
    this.simplesCls = simples ? 'op sel' : 'op'
    this.simplesTextoCls = simples ? 'opTextoSel' : 'opTexto'
    this.compostoCls = simples ? 'op' : 'op sel'
    this.compostoTextoCls = simples ? 'opTexto' : 'opTextoSel'
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(CAMPOS[this.campo].id, this.rascunho)
    this.mostrado = texto
    this.digitadoCls = 'digitado ' + fonte(texto, 40, LARGURA_TELA)
  },

  mostrarAviso(erro) {
    this.aviso = erro ? erro : CAMPOS[this.campo].dica
    this.avisoCls = (erro ? 'erro ' : 'dica ') + fonte(this.aviso, 18, LARGURA_TELA)
  },

  abrir(indice, origem) {
    var campo = CAMPOS[indice]
    this.campo = indice
    this.origem = origem
    this.rascunho = this.textos[indice]
    this.titulo = campo.titulo
    this.teclas = campo.decimais === 0 ? TECLAS_INTEIRAS : TECLAS_DECIMAIS
    this.mostrarAviso('')
    this.atualizarTeclado()
    this.mostrar('teclado')
  },

  abrirValor() {
    this.abrir(0, 'tela1')
  },

  abrirParcelas() {
    this.abrir(1, 'tela1')
  },

  abrirTaxa() {
    this.abrir(2, 'tela2')
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, CAMPOS[this.campo])
    this.mostrarAviso('')
    this.atualizarTeclado()
  },

  confirmar() {
    var erro = validar(CAMPOS[this.campo].id, paraNumero(this.rascunho))
    if (erro) {
      this.mostrarAviso(erro)
      return
    }
    // Cópia da lista para a tela perceber a mudança.
    var textos = this.textos.slice()
    textos[this.campo] = this.rascunho
    this.textos = textos
    this.atualizarCampos()
    this.mostrar(this.origem)
  },

  cancelar() {
    this.mostrar(this.origem)
  },

  irTela1() {
    this.mostrar('tela1')
  },

  irTela2() {
    this.mostrar('tela2')
  },

  escolherSimples() {
    this.tipo = 'simples'
    this.atualizarTipo()
  },

  escolherComposto() {
    this.tipo = 'composto'
    this.atualizarTipo()
  },

  calcularConta() {
    if (!this.pronto) return
    var valor = paraNumero(this.textos[0])
    var parcelas = paraNumero(this.textos[1])
    var taxa = paraNumero(this.textos[2])
    var r = calcular(valor, parcelas, taxa, this.tipo)
    this.tituloResultado = this.tipo === 'simples' ? 'Juros simples' : 'Juros compostos'
    this.tituloResultadoCls = 'tituloResultado ' + fonte(this.tituloResultado, 24, LARGURA_TELA)
    this.resumo1 = reais(valor)
    this.resumo1Cls = 'resumo ' + fonte(this.resumo1, 20, LARGURA_TELA)
    this.resumo2 = parcelas + 'x · ' + porcento(taxa) + ' ao mês'
    this.resumo2Cls = 'resumo ' + fonte(this.resumo2, 20, LARGURA_TELA)
    this.total = reais(r.montante)
    this.totalCls = 'total ' + fonte(this.total, 36, LARGURA_TELA)
    this.juros = reais(r.juros)
    this.jurosCls = 'linhaValor ' + fonte(this.juros, 28, LARGURA_TELA)
    this.legendaParcela = 'Cada parcela (' + parcelas + 'x)'
    this.parcela = reais(r.parcela)
    this.parcelaCls = 'linhaValor ' + fonte(this.parcela, 28, LARGURA_TELA)
    this.mostrar('resultado')
  },

  voltar() {
    this.mostrar('tela2')
  },

  novaConta() {
    this.textos = ['', '', '']
    this.atualizarCampos()
    this.mostrar('tela1')
  },

  // Gesto de voltar da banda: teclado → tela de onde veio; resultado → tela 2; tela 2 → tela 1;
  // na tela 1, fecha o app. Mesmo padrão de uma calculadora que já roda na Mi Band 10 (sempre
  // retorna true e sai com this.$app.exit()).
  onBackPress() {
    if (this.tela1) {
      this.$app.exit()
    } else if (this.telaTeclado) {
      this.mostrar(this.origem)
    } else if (this.telaResultado) {
      this.mostrar('tela2')
    } else {
      this.mostrar('tela1')
    }
    return true
  }
}
</script>

<style>
/* Letras grandes e tudo cabendo na tela (212 × 520), sem rolar. */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 36px 10px 30px 10px;
}

.tela {
  flex: 1;
  flex-direction: column;
}

.centro {
  align-items: center;
}

.espaco {
  flex: 1;
}

/* Telas 1 e 2 */
.cabecalho {
  font-size: 22px;
  color: #8a8a8e;
  text-align: center;
}

.cabecalhoToque {
  height: 36px;
  justify-content: center;
  align-items: center;
  margin-bottom: 6px;
}

.barra {
  height: 116px;
  margin-top: 10px;
  padding: 0 12px;
  border-radius: 26px;
  flex-direction: column;
  justify-content: center;
  background-color: #1c1c1e;
}

.barraTipo {
  padding: 10px 12px 12px 12px;
  border-radius: 26px;
  flex-direction: column;
  background-color: #1c1c1e;
}

.rotulo {
  font-size: 19px;
  color: #8a8a8e;
  margin-bottom: 4px;
}

.valor {
  color: #ffffff;
}

.vazio {
  font-size: 22px;
  color: #6e6e73;
}

.op {
  height: 54px;
  margin-top: 8px;
  border-radius: 27px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.sel {
  background-color: #ff9f0a;
}

.opTexto {
  font-size: 24px;
  color: #c7c7cc;
}

.opTextoSel {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

.botaoGrande {
  height: 72px;
  border-radius: 36px;
  justify-content: center;
  align-items: center;
}

.laranja { background-color: #ff9f0a; }
.verde { background-color: #30d158; }
.cinza { background-color: #3a3a3c; }
.off { background-color: #2c2c2e; }

.textoBotaoEscuro {
  font-size: 26px;
  color: #000000;
  font-weight: bold;
}

.textoBotaoClaro {
  font-size: 24px;
  color: #ffffff;
}

.textoBotaoOff {
  font-size: 22px;
  color: #6e6e73;
}

/* Teclado */
.topo {
  height: 124px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 22px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 8px;
  text-align: center;
}

.dica {
  color: #8a8a8e;
  margin-top: 4px;
  text-align: center;
}

.erro {
  color: #ff453a;
  margin-top: 4px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }
.apagada { background-color: #000000; }

.rotuloTecla {
  font-size: 36px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 19px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.tituloResultado {
  color: #ff9f0a;
  text-align: center;
  margin-bottom: 4px;
}

.resumo {
  color: #c7c7cc;
  text-align: center;
}

.legenda {
  font-size: 19px;
  color: #8a8a8e;
  margin-top: 10px;
}

.total {
  color: #30d158;
  font-weight: bold;
  text-align: center;
}

.linhaValor {
  color: #ffffff;
  text-align: center;
}

.botoes {
  flex-direction: row;
  width: 100%;
}

.botao {
  flex: 1;
  height: 64px;
  margin: 0 3px;
  border-radius: 32px;
  justify-content: center;
  align-items: center;
}

/* Tamanhos de letra escolhidos no script conforme o texto (função fonte). */
.f40 { font-size: 40px; }
.f36 { font-size: 36px; }
.f32 { font-size: 32px; }
.f28 { font-size: 28px; }
.f24 { font-size: 24px; }
.f22 { font-size: 22px; }
.f20 { font-size: 20px; }
.f18 { font-size: 18px; }
.f16 { font-size: 16px; }
</style>
