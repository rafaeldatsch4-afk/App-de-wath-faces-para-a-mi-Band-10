<template>
  <div class="page">
    <!-- Tela principal (rola): Valor, Parcelas, Tipo de juros, Taxa e o botão Calcular -->
    <list class="lista" if="{{telaPrincipal}}">
      <list-item type="topo" class="itemTopo">
        <text class="app">Juros</text>
      </list-item>
      <list-item type="valor" class="item">
        <div class="barra" onclick="abrirValor">
          <text class="rotulo">Valor</text>
          <text class="{{valorCls}}">{{valorTexto}}</text>
        </div>
      </list-item>
      <list-item type="parcelas" class="item">
        <div class="barra" onclick="abrirParcelas">
          <text class="rotulo">Parcelas (vezes)</text>
          <text class="{{parcelasCls}}">{{parcelasTexto}}</text>
        </div>
      </list-item>
      <list-item type="tipo" class="item">
        <div class="barraTipo">
          <text class="rotulo">Tipo de juros</text>
          <div class="{{simplesCls}}" onclick="escolherSimples">
            <text class="{{simplesTextoCls}}">Simples</text>
          </div>
          <div class="{{compostoCls}}" onclick="escolherComposto">
            <text class="{{compostoTextoCls}}">Composto</text>
          </div>
        </div>
      </list-item>
      <list-item type="taxa" class="item">
        <div class="barra" onclick="abrirTaxa">
          <text class="rotulo">Taxa ao mês (%)</text>
          <text class="{{taxaCls}}">{{taxaTexto}}</text>
        </div>
      </list-item>
      <list-item type="calcular" class="item">
        <div class="{{calcularCls}}" onclick="calcularConta">
          <text class="{{calcularTextoCls}}">Calcular</text>
        </div>
      </list-item>
      <list-item type="fim" class="itemFim">
        <text class="fim"> </text>
      </list-item>
    </list>

    <!-- Teclado de um campo (não rola: ocupa a tela toda) -->
    <div class="tela" if="{{telaTeclado}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="{{digitadoCls}}">{{mostrado}}</text>
        <text class="{{avisoCls}}">{{aviso}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="{{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">Cancelar</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado (rola) -->
    <list class="lista" if="{{telaResultado}}">
      <list-item type="rtitulo" class="itemTopo">
        <text class="{{tituloResultadoCls}}">{{tituloResultado}}</text>
        <text class="{{resumo1Cls}}">{{resumo1}}</text>
        <text class="{{resumo2Cls}}">{{resumo2}}</text>
      </list-item>
      <list-item type="rtotal" class="itemCentro">
        <text class="legenda">Total a pagar</text>
        <text class="{{totalCls}}">{{total}}</text>
      </list-item>
      <list-item type="rjuros" class="itemCentro">
        <text class="legenda">Juros</text>
        <text class="{{jurosCls}}">{{juros}}</text>
      </list-item>
      <list-item type="rparcela" class="itemCentro">
        <text class="legenda">{{legendaParcela}}</text>
        <text class="{{parcelaCls}}">{{parcela}}</text>
      </list-item>
      <list-item type="rvoltar" class="item">
        <div class="botao" onclick="voltar">
          <text class="rotuloBotao">Voltar</text>
        </div>
      </list-item>
      <list-item type="rnova" class="item">
        <div class="botao verde" onclick="novaConta">
          <text class="rotuloBotaoOk">Nova conta</text>
        </div>
      </list-item>
      <list-item type="rfim" class="itemFim">
        <text class="fim"> </text>
      </list-item>
    </list>
  </div>
</template>

<script>
import { CAMPOS, calcular, digitar, mostrarCampo, mostrarRascunho, paraNumero, porcento, reais, validar } from '../../common/juros.js'

// Só padrões já usados por mini-apps que rodam na banda: propriedades simples no template
// (sem índice de lista nem expressão), classes prontas e "for" sobre listas de objetos.

function k(t, key, cls) {
  return { t: t, k: key, cls: 'tecla ' + cls }
}

var NUMEROS = [
  [k('1', '1', ''), k('2', '2', ''), k('3', '3', '')],
  [k('4', '4', ''), k('5', '5', ''), k('6', '6', '')],
  [k('7', '7', ''), k('8', '8', ''), k('9', '9', '')]
]
var TECLAS_DECIMAIS = NUMEROS.concat([[k(',', ',', 'fn'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])
// Parcelas não têm vírgula: a tecla fica apagada.
var TECLAS_INTEIRAS = NUMEROS.concat([[k('', '', 'apagada'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])

var VAZIO = 'Tocar aqui'

// Maior letra (classe .fNN) em que o texto cabe em [largura] px. Cada caractere ocupa até
// ~0,62 da altura da letra (medido com uma fonte mais larga que a da banda, por segurança).
var FONTES = [40, 36, 32, 28, 24, 22, 20, 18, 16]
function fonte(texto, maximo, largura) {
  for (var i = 0; i < FONTES.length; i++) {
    var f = FONTES[i]
    if (f <= maximo && texto.length * f * 0.62 <= largura) return 'f' + f
  }
  return 'f16'
}

// Larguras úteis: tela 212 − 2×10 de margem; barras têm mais 2×12 por dentro.
var LARGURA_TELA = 192
var LARGURA_BARRA = 168

function clsBarra(texto) {
  return 'valor ' + fonte(texto, 32, LARGURA_BARRA)
}

export default {
  private: {
    telaPrincipal: true,
    telaTeclado: false,
    telaResultado: false,
    // Textos confirmados de cada campo ('' = ainda não preenchido).
    textos: ['', '', ''],
    valorTexto: VAZIO,
    valorCls: 'vazio',
    parcelasTexto: VAZIO,
    parcelasCls: 'vazio',
    taxaTexto: VAZIO,
    taxaCls: 'vazio',
    pronto: false,
    calcularCls: 'calcular off',
    calcularTextoCls: 'calcularTextoOff',
    tipo: 'composto',
    simplesCls: 'op',
    simplesTextoCls: 'opTexto',
    compostoCls: 'op sel',
    compostoTextoCls: 'opTextoSel',
    // Teclado
    campo: 0,
    rascunho: '',
    titulo: '',
    mostrado: '',
    digitadoCls: 'digitado f40',
    aviso: '',
    avisoCls: 'dica f18',
    teclas: TECLAS_DECIMAIS,
    // Resultado
    tituloResultado: '',
    resumo1: '',
    resumo2: '',
    total: '',
    tituloResultadoCls: 'tituloResultado f22',
    resumo1Cls: 'resumo f18',
    resumo2Cls: 'resumo f18',
    totalCls: 'total f36',
    juros: '',
    jurosCls: 'linhaValor f28',
    legendaParcela: 'Cada parcela',
    parcela: '',
    parcelaCls: 'linhaValor f28'
  },

  mostrar(tela) {
    this.telaPrincipal = tela === 'principal'
    this.telaTeclado = tela === 'teclado'
    this.telaResultado = tela === 'resultado'
  },

  textoBarra(indice) {
    var texto = this.textos[indice]
    return texto === '' ? VAZIO : mostrarCampo(CAMPOS[indice].id, paraNumero(texto))
  },

  atualizarPrincipal() {
    var t = this.textos
    this.valorTexto = this.textoBarra(0)
    this.valorCls = t[0] === '' ? 'vazio' : clsBarra(this.valorTexto)
    this.parcelasTexto = this.textoBarra(1)
    this.parcelasCls = t[1] === '' ? 'vazio' : clsBarra(this.parcelasTexto)
    this.taxaTexto = this.textoBarra(2)
    this.taxaCls = t[2] === '' ? 'vazio' : clsBarra(this.taxaTexto)
    this.pronto = t[0] !== '' && t[1] !== '' && t[2] !== ''
    this.calcularCls = this.pronto ? 'calcular' : 'calcular off'
    this.calcularTextoCls = this.pronto ? 'calcularTexto' : 'calcularTextoOff'
  },

  atualizarTipo() {
    var simples = this.tipo === 'simples'
    this.simplesCls = simples ? 'op sel' : 'op'
    this.simplesTextoCls = simples ? 'opTextoSel' : 'opTexto'
    this.compostoCls = simples ? 'op' : 'op sel'
    this.compostoTextoCls = simples ? 'opTexto' : 'opTextoSel'
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(CAMPOS[this.campo].id, this.rascunho)
    this.mostrado = texto
    this.digitadoCls = 'digitado ' + fonte(texto, 40, LARGURA_TELA)
  },

  mostrarAviso(erro) {
    this.aviso = erro ? erro : CAMPOS[this.campo].dica
    this.avisoCls = (erro ? 'erro ' : 'dica ') + fonte(this.aviso, 18, LARGURA_TELA)
  },

  abrir(indice) {
    var campo = CAMPOS[indice]
    this.campo = indice
    this.rascunho = this.textos[indice]
    this.titulo = campo.titulo
    this.teclas = campo.decimais === 0 ? TECLAS_INTEIRAS : TECLAS_DECIMAIS
    this.mostrarAviso('')
    this.atualizarTeclado()
    this.mostrar('teclado')
  },

  abrirValor() {
    this.abrir(0)
  },

  abrirParcelas() {
    this.abrir(1)
  },

  abrirTaxa() {
    this.abrir(2)
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, CAMPOS[this.campo])
    this.mostrarAviso('')
    this.atualizarTeclado()
  },

  confirmar() {
    var erro = validar(CAMPOS[this.campo].id, paraNumero(this.rascunho))
    if (erro) {
      this.mostrarAviso(erro)
      return
    }
    // Cópia da lista para a tela perceber a mudança.
    var textos = this.textos.slice()
    textos[this.campo] = this.rascunho
    this.textos = textos
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  cancelar() {
    this.mostrar('principal')
  },

  escolherSimples() {
    this.tipo = 'simples'
    this.atualizarTipo()
  },

  escolherComposto() {
    this.tipo = 'composto'
    this.atualizarTipo()
  },

  calcularConta() {
    if (!this.pronto) return
    var valor = paraNumero(this.textos[0])
    var parcelas = paraNumero(this.textos[1])
    var taxa = paraNumero(this.textos[2])
    var r = calcular(valor, parcelas, taxa, this.tipo)
    this.tituloResultado = this.tipo === 'simples' ? 'Juros simples' : 'Juros compostos'
    this.resumo1 = reais(valor)
    this.resumo2 = parcelas + 'x · ' + porcento(taxa) + ' ao mês'
    this.total = reais(r.montante)
    this.tituloResultadoCls = 'tituloResultado ' + fonte(this.tituloResultado, 24, LARGURA_TELA)
    this.resumo1Cls = 'resumo ' + fonte(this.resumo1, 20, LARGURA_TELA)
    this.resumo2Cls = 'resumo ' + fonte(this.resumo2, 20, LARGURA_TELA)
    this.totalCls = 'total ' + fonte(this.total, 36, LARGURA_TELA)
    this.juros = reais(r.juros)
    this.jurosCls = 'linhaValor ' + fonte(this.juros, 28, LARGURA_TELA)
    this.legendaParcela = 'Cada parcela (' + parcelas + 'x)'
    this.parcela = reais(r.parcela)
    this.parcelaCls = 'linhaValor ' + fonte(this.parcela, 28, LARGURA_TELA)
    this.mostrar('resultado')
  },

  voltar() {
    this.mostrar('principal')
  },

  novaConta() {
    this.textos = ['', '', '']
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  // Gesto de voltar da banda: no teclado ou no resultado, volta para a tela principal em vez de
  // fechar o app e perder o que foi digitado; na tela principal, fecha o app. Mesmo padrão de uma
  // calculadora que já roda na Mi Band 10 (sempre retorna true e sai com this.$app.exit()).
  onBackPress() {
    if (this.telaPrincipal) {
      this.$app.exit()
    } else {
      this.mostrar('principal')
    }
    return true
  }
}
</script>

<style>
/* Tudo grande para ler no pulso: a tela principal e o resultado rolam para baixo. */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 0 10px;
}

.lista {
  flex: 1;
  flex-direction: column;
}

.item {
  flex-direction: column;
  margin-bottom: 10px;
}

/* A ponta da tela é arredondada: espaço em cima e embaixo. */
.itemTopo {
  flex-direction: column;
  align-items: center;
  padding-top: 34px;
  margin-bottom: 10px;
}

.itemCentro {
  flex-direction: column;
  align-items: center;
  margin-bottom: 14px;
}

.itemFim {
  height: 60px;
}

.fim {
  font-size: 10px;
  color: #000000;
}

/* Tela principal */
.app {
  font-size: 22px;
  color: #8a8a8e;
  text-align: center;
}

.barra {
  height: 100px;
  padding: 0 12px;
  border-radius: 26px;
  flex-direction: column;
  justify-content: center;
  background-color: #1c1c1e;
}

.barraTipo {
  padding: 12px;
  border-radius: 26px;
  flex-direction: column;
  background-color: #1c1c1e;
}

.rotulo {
  font-size: 18px;
  color: #8a8a8e;
  margin-bottom: 4px;
}

.valor {
  color: #ffffff;
}


.vazio {
  font-size: 20px;
  color: #6e6e73;
}

.op {
  height: 58px;
  margin-top: 8px;
  border-radius: 29px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.sel {
  background-color: #ff9f0a;
}

.opTexto {
  font-size: 24px;
  color: #c7c7cc;
}

.opTextoSel {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

.calcular {
  height: 76px;
  border-radius: 38px;
  justify-content: center;
  align-items: center;
  background-color: #30d158;
}

.off {
  background-color: #2c2c2e;
}

.calcularTexto {
  font-size: 30px;
  color: #000000;
  font-weight: bold;
}

.calcularTextoOff {
  font-size: 30px;
  color: #6e6e73;
  font-weight: bold;
}

/* Teclado */
.tela {
  flex: 1;
  flex-direction: column;
  padding: 30px 0 28px 0;
}

.topo {
  height: 124px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 22px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 8px;
  text-align: center;
}

/* Tamanhos de letra escolhidos no script conforme o texto (função fonte). */
.f40 { font-size: 40px; }
.f36 { font-size: 36px; }
.f32 { font-size: 32px; }
.f28 { font-size: 28px; }
.f24 { font-size: 24px; }
.f22 { font-size: 22px; }
.f20 { font-size: 20px; }
.f18 { font-size: 18px; }
.f16 { font-size: 16px; }

.dica {
  color: #8a8a8e;
  margin-top: 4px;
  text-align: center;
}

.erro {
  color: #ff453a;
  margin-top: 4px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }
.apagada { background-color: #000000; }

.rotuloTecla {
  font-size: 36px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 19px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.tituloResultado {
  color: #ff9f0a;
  text-align: center;
  margin-bottom: 6px;
}

.resumo {
  color: #c7c7cc;
  text-align: center;
}

.legenda {
  font-size: 19px;
  color: #8a8a8e;
}

.total {
  color: #30d158;
  font-weight: bold;
  text-align: center;
}


.linhaValor {
  color: #ffffff;
  text-align: center;
}


.botao {
  height: 72px;
  border-radius: 36px;
  justify-content: center;
  align-items: center;
  background-color: #3a3a3c;
}

.verde { background-color: #30d158; }

.rotuloBotao {
  font-size: 26px;
  color: #ffffff;
}

.rotuloBotaoOk {
  font-size: 26px;
  color: #000000;
  font-weight: bold;
}
</style>
