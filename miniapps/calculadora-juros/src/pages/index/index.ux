<template>
  <div class="page">
    <!-- Tela principal: barras de Valor, Parcelas, Tipo de juros e Taxa, e o botão Calcular -->
    <div class="tela" if="{{tela === 'principal'}}">
      <text class="app">Juros</text>
      <div class="barra" onclick="abrir(0)">
        <text class="rotulo">Valor</text>
        <text class="{{barras[0].cls}}">{{barras[0].texto}}</text>
      </div>
      <div class="barra" onclick="abrir(1)">
        <text class="rotulo">Parcelas (vezes)</text>
        <text class="{{barras[1].cls}}">{{barras[1].texto}}</text>
      </div>
      <div class="barra tipo">
        <text class="rotuloTipo">Tipo de juros</text>
        <div class="seg">
          <div class="op {{tipo === 'simples' ? 'sel' : ''}}" onclick="escolher('simples')">
            <text class="{{tipo === 'simples' ? 'opTextoSel' : 'opTexto'}}">Simples</text>
          </div>
          <div class="op {{tipo === 'composto' ? 'sel' : ''}}" onclick="escolher('composto')">
            <text class="{{tipo === 'composto' ? 'opTextoSel' : 'opTexto'}}">Composto</text>
          </div>
        </div>
      </div>
      <div class="barra" onclick="abrir(2)">
        <text class="rotulo">Taxa de juros ao mês</text>
        <text class="{{barras[2].cls}}">{{barras[2].texto}}</text>
      </div>
      <div class="espaco"></div>
      <div class="calcular {{pronto ? '' : 'off'}}" onclick="calcularConta">
        <text class="{{pronto ? 'calcularTexto' : 'calcularTextoOff'}}">Calcular</text>
      </div>
    </div>

    <!-- Teclado de um campo -->
    <div class="tela" if="{{tela === 'teclado'}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="digitado {{tamanho}}">{{mostrado}}</text>
        <text class="{{erro ? 'erro' : 'dica'}}">{{erro ? erro : dica}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="tecla {{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">Cancelar</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado -->
    <div class="tela centro" if="{{tela === 'resultado'}}">
      <text class="titulo">Juros {{tipo === 'simples' ? 'simples' : 'compostos'}}</text>
      <text class="resumo">{{resumo1}}</text>
      <text class="resumo">{{resumo2}}</text>
      <text class="legenda">Total a pagar</text>
      <text class="total {{tamanhoTotal}}">{{total}}</text>
      <text class="legenda">Juros</text>
      <text class="linhaValor">{{juros}}</text>
      <text class="legenda">Cada parcela</text>
      <text class="linhaValor">{{parcela}}</text>
      <div class="espaco"></div>
      <div class="botoes">
        <div class="botao" onclick="voltar">
          <text class="rotuloNav">Voltar</text>
        </div>
        <div class="botao verde" onclick="novaConta">
          <text class="rotuloOk">Nova</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { CAMPOS, calcular, digitar, mostrarCampo, mostrarRascunho, paraNumero, porcento, reais, validar } from '../../common/juros.js'

function k(t, key, cls) {
  return { t: t, k: key, cls: cls }
}

var NUMEROS = [
  [k('1', '1', ''), k('2', '2', ''), k('3', '3', '')],
  [k('4', '4', ''), k('5', '5', ''), k('6', '6', '')],
  [k('7', '7', ''), k('8', '8', ''), k('9', '9', '')]
]
var TECLAS_DECIMAIS = NUMEROS.concat([[k(',', ',', 'fn'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])
// Parcelas não têm vírgula: a tecla fica apagada.
var TECLAS_INTEIRAS = NUMEROS.concat([[k('', '', 'apagada'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])

var VAZIO = { texto: 'Tocar para digitar', cls: 'vazio' }

export default {
  private: {
    tela: 'principal',
    // Textos confirmados de cada campo ('' = ainda não preenchido).
    textos: ['', '', ''],
    barras: [VAZIO, VAZIO, VAZIO],
    pronto: false,
    tipo: 'composto',
    // Teclado
    campo: 0,
    rascunho: '',
    titulo: '',
    mostrado: '',
    tamanho: 'grande',
    dica: '',
    erro: '',
    teclas: TECLAS_DECIMAIS,
    // Resultado
    resumo1: '',
    resumo2: '',
    total: '',
    tamanhoTotal: 'grande',
    juros: '',
    parcela: ''
  },

  atualizarPrincipal() {
    var barras = []
    var pronto = true
    for (var i = 0; i < CAMPOS.length; i++) {
      var texto = this.textos[i]
      if (texto === '') {
        barras.push(VAZIO)
        pronto = false
      } else {
        barras.push({ texto: mostrarCampo(CAMPOS[i].id, paraNumero(texto)), cls: 'valor' })
      }
    }
    this.barras = barras
    this.pronto = pronto
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(CAMPOS[this.campo].id, this.rascunho)
    this.mostrado = texto
    this.tamanho = texto.length <= 11 ? 'grande' : texto.length <= 14 ? 'medio' : 'pequeno'
  },

  abrir(indice) {
    var campo = CAMPOS[indice]
    this.campo = indice
    this.rascunho = this.textos[indice]
    this.titulo = campo.titulo
    this.dica = campo.dica
    this.erro = ''
    this.teclas = campo.decimais === 0 ? TECLAS_INTEIRAS : TECLAS_DECIMAIS
    this.atualizarTeclado()
    this.tela = 'teclado'
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, CAMPOS[this.campo])
    this.erro = ''
    this.atualizarTeclado()
  },

  confirmar() {
    var erro = validar(CAMPOS[this.campo].id, paraNumero(this.rascunho))
    if (erro) {
      this.erro = erro
      return
    }
    // Cópia da lista para a tela perceber a mudança.
    var textos = this.textos.slice()
    textos[this.campo] = this.rascunho
    this.textos = textos
    this.atualizarPrincipal()
    this.tela = 'principal'
  },

  cancelar() {
    this.tela = 'principal'
  },

  escolher(tipo) {
    this.tipo = tipo
  },

  calcularConta() {
    if (!this.pronto) return
    var valor = paraNumero(this.textos[0])
    var parcelas = paraNumero(this.textos[1])
    var taxa = paraNumero(this.textos[2])
    var r = calcular(valor, parcelas, taxa, this.tipo)
    this.resumo1 = reais(valor) + ' em ' + parcelas + 'x'
    this.resumo2 = porcento(taxa) + ' ao mês'
    this.total = reais(r.montante)
    this.tamanhoTotal = this.total.length <= 12 ? 'grande' : this.total.length <= 16 ? 'medio' : 'pequeno'
    this.juros = reais(r.juros)
    this.parcela = parcelas + 'x de ' + reais(r.parcela)
    this.tela = 'resultado'
  },

  voltar() {
    this.tela = 'principal'
  },

  novaConta() {
    this.textos = ['', '', '']
    this.atualizarPrincipal()
    this.tela = 'principal'
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 40px 12px 44px 12px;
}

.tela {
  flex: 1;
  flex-direction: column;
}

.centro {
  align-items: center;
}

.espaco {
  flex: 1;
}

/* Tela principal */
.app {
  font-size: 15px;
  color: #8a8a8e;
  text-align: center;
  margin-bottom: 8px;
}

.barra {
  height: 72px;
  margin: 4px 0;
  padding: 0 14px;
  border-radius: 22px;
  flex-direction: column;
  justify-content: center;
  background-color: #1c1c1e;
}

.rotulo {
  font-size: 14px;
  color: #8a8a8e;
}

.valor {
  font-size: 22px;
  color: #ffffff;
}

.vazio {
  font-size: 16px;
  color: #5a5a5e;
}

.tipo {
  padding: 0 8px;
}

.rotuloTipo {
  font-size: 14px;
  color: #8a8a8e;
  padding-left: 6px;
  margin-bottom: 6px;
}

.seg {
  flex-direction: row;
}

.op {
  flex: 1;
  height: 36px;
  margin: 0 2px;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.sel {
  background-color: #ff9f0a;
}

.opTexto {
  font-size: 14px;
  color: #c7c7cc;
}

.opTextoSel {
  font-size: 14px;
  color: #000000;
  font-weight: bold;
}

.calcular {
  height: 52px;
  margin: 0 10px;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  background-color: #30d158;
}

.off {
  background-color: #2c2c2e;
}

.calcularTexto {
  font-size: 20px;
  color: #000000;
  font-weight: bold;
}

.calcularTextoOff {
  font-size: 20px;
  color: #5a5a5e;
  font-weight: bold;
}

/* Teclado */
.topo {
  height: 132px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 20px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 14px;
  text-align: center;
}

.grande { font-size: 30px; }
.medio { font-size: 24px; }
.pequeno { font-size: 18px; }

.dica {
  font-size: 13px;
  color: #8a8a8e;
  margin-top: 6px;
  text-align: center;
}

.erro {
  font-size: 13px;
  color: #ff453a;
  margin-top: 6px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }
.apagada { background-color: #000000; }

.rotuloTecla {
  font-size: 26px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 17px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 17px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.resumo {
  font-size: 13px;
  color: #c7c7cc;
  text-align: center;
}

.legenda {
  font-size: 14px;
  color: #8a8a8e;
  margin-top: 14px;
}

.total {
  color: #30d158;
  font-weight: bold;
  text-align: center;
}

.linhaValor {
  font-size: 20px;
  color: #ffffff;
  text-align: center;
}

.botoes {
  flex-direction: row;
  width: 100%;
  padding: 0 6px;
}

.botao {
  flex: 1;
  height: 52px;
  margin: 0 3px;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  background-color: #3a3a3c;
}

.verde { background-color: #30d158; }
</style>
