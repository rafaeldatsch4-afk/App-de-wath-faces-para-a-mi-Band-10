<template>
  <div class="page">
    <!-- Tela principal: barras de Valor, Parcelas, Tipo de juros e Taxa, e o botão Calcular -->
    <div class="tela" if="{{telaPrincipal}}">
      <text class="app">Juros</text>
      <div class="barra" onclick="abrirValor">
        <text class="rotulo">Valor</text>
        <text class="{{valorCls}}">{{valorTexto}}</text>
      </div>
      <div class="barra" onclick="abrirParcelas">
        <text class="rotulo">Parcelas (vezes)</text>
        <text class="{{parcelasCls}}">{{parcelasTexto}}</text>
      </div>
      <div class="barra tipo">
        <text class="rotuloTipo">Tipo de juros</text>
        <div class="seg">
          <div class="{{simplesCls}}" onclick="escolherSimples">
            <text class="{{simplesTextoCls}}">Simples</text>
          </div>
          <div class="{{compostoCls}}" onclick="escolherComposto">
            <text class="{{compostoTextoCls}}">Composto</text>
          </div>
        </div>
      </div>
      <div class="barra" onclick="abrirTaxa">
        <text class="rotulo">Taxa de juros ao mês</text>
        <text class="{{taxaCls}}">{{taxaTexto}}</text>
      </div>
      <div class="espaco"></div>
      <div class="{{calcularCls}}" onclick="calcularConta">
        <text class="{{calcularTextoCls}}">Calcular</text>
      </div>
    </div>

    <!-- Teclado de um campo -->
    <div class="tela" if="{{telaTeclado}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="{{digitadoCls}}">{{mostrado}}</text>
        <text class="{{avisoCls}}">{{aviso}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="{{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">Cancelar</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado -->
    <div class="tela centro" if="{{telaResultado}}">
      <text class="titulo">{{tituloResultado}}</text>
      <text class="resumo">{{resumo1}}</text>
      <text class="resumo">{{resumo2}}</text>
      <text class="legenda">Total a pagar</text>
      <text class="{{totalCls}}">{{total}}</text>
      <text class="legenda">Juros</text>
      <text class="linhaValor">{{juros}}</text>
      <text class="legenda">Cada parcela</text>
      <text class="linhaValor">{{parcela}}</text>
      <div class="espaco"></div>
      <div class="botoes">
        <div class="botao" onclick="voltar">
          <text class="rotuloNav">Voltar</text>
        </div>
        <div class="botao verde" onclick="novaConta">
          <text class="rotuloOk">Nova</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { CAMPOS, calcular, digitar, mostrarCampo, mostrarRascunho, paraNumero, porcento, reais, validar } from '../../common/juros.js'

// Só padrões já usados por mini-apps que rodam na banda: propriedades simples no template
// (sem índice de lista nem expressão), classes prontas e "for" sobre listas de objetos.

function k(t, key, cls) {
  return { t: t, k: key, cls: 'tecla ' + cls }
}

var NUMEROS = [
  [k('1', '1', ''), k('2', '2', ''), k('3', '3', '')],
  [k('4', '4', ''), k('5', '5', ''), k('6', '6', '')],
  [k('7', '7', ''), k('8', '8', ''), k('9', '9', '')]
]
var TECLAS_DECIMAIS = NUMEROS.concat([[k(',', ',', 'fn'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])
// Parcelas não têm vírgula: a tecla fica apagada.
var TECLAS_INTEIRAS = NUMEROS.concat([[k('', '', 'apagada'), k('0', '0', ''), k('⌫', 'DEL', 'fn')]])

var VAZIO = 'Tocar para digitar'

function tamanho(texto, a, b) {
  return texto.length <= a ? 'grande' : texto.length <= b ? 'medio' : 'pequeno'
}

export default {
  private: {
    telaPrincipal: true,
    telaTeclado: false,
    telaResultado: false,
    // Textos confirmados de cada campo ('' = ainda não preenchido).
    textos: ['', '', ''],
    valorTexto: VAZIO,
    valorCls: 'vazio',
    parcelasTexto: VAZIO,
    parcelasCls: 'vazio',
    taxaTexto: VAZIO,
    taxaCls: 'vazio',
    pronto: false,
    calcularCls: 'calcular off',
    calcularTextoCls: 'calcularTextoOff',
    tipo: 'composto',
    simplesCls: 'op',
    simplesTextoCls: 'opTexto',
    compostoCls: 'op sel',
    compostoTextoCls: 'opTextoSel',
    // Teclado
    campo: 0,
    rascunho: '',
    titulo: '',
    mostrado: '',
    digitadoCls: 'digitado grande',
    aviso: '',
    avisoCls: 'dica',
    teclas: TECLAS_DECIMAIS,
    // Resultado
    tituloResultado: '',
    resumo1: '',
    resumo2: '',
    total: '',
    totalCls: 'total grande',
    juros: '',
    parcela: ''
  },

  mostrar(tela) {
    this.telaPrincipal = tela === 'principal'
    this.telaTeclado = tela === 'teclado'
    this.telaResultado = tela === 'resultado'
  },

  textoBarra(indice) {
    var texto = this.textos[indice]
    return texto === '' ? VAZIO : mostrarCampo(CAMPOS[indice].id, paraNumero(texto))
  },

  atualizarPrincipal() {
    var t = this.textos
    this.valorTexto = this.textoBarra(0)
    this.valorCls = t[0] === '' ? 'vazio' : 'valor'
    this.parcelasTexto = this.textoBarra(1)
    this.parcelasCls = t[1] === '' ? 'vazio' : 'valor'
    this.taxaTexto = this.textoBarra(2)
    this.taxaCls = t[2] === '' ? 'vazio' : 'valor'
    this.pronto = t[0] !== '' && t[1] !== '' && t[2] !== ''
    this.calcularCls = this.pronto ? 'calcular' : 'calcular off'
    this.calcularTextoCls = this.pronto ? 'calcularTexto' : 'calcularTextoOff'
  },

  atualizarTipo() {
    var simples = this.tipo === 'simples'
    this.simplesCls = simples ? 'op sel' : 'op'
    this.simplesTextoCls = simples ? 'opTextoSel' : 'opTexto'
    this.compostoCls = simples ? 'op' : 'op sel'
    this.compostoTextoCls = simples ? 'opTexto' : 'opTextoSel'
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(CAMPOS[this.campo].id, this.rascunho)
    this.mostrado = texto
    this.digitadoCls = 'digitado ' + tamanho(texto, 11, 14)
  },

  mostrarAviso(erro) {
    this.aviso = erro ? erro : CAMPOS[this.campo].dica
    this.avisoCls = erro ? 'erro' : 'dica'
  },

  abrir(indice) {
    var campo = CAMPOS[indice]
    this.campo = indice
    this.rascunho = this.textos[indice]
    this.titulo = campo.titulo
    this.teclas = campo.decimais === 0 ? TECLAS_INTEIRAS : TECLAS_DECIMAIS
    this.mostrarAviso('')
    this.atualizarTeclado()
    this.mostrar('teclado')
  },

  abrirValor() {
    this.abrir(0)
  },

  abrirParcelas() {
    this.abrir(1)
  },

  abrirTaxa() {
    this.abrir(2)
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, CAMPOS[this.campo])
    this.mostrarAviso('')
    this.atualizarTeclado()
  },

  confirmar() {
    var erro = validar(CAMPOS[this.campo].id, paraNumero(this.rascunho))
    if (erro) {
      this.mostrarAviso(erro)
      return
    }
    // Cópia da lista para a tela perceber a mudança.
    var textos = this.textos.slice()
    textos[this.campo] = this.rascunho
    this.textos = textos
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  cancelar() {
    this.mostrar('principal')
  },

  escolherSimples() {
    this.tipo = 'simples'
    this.atualizarTipo()
  },

  escolherComposto() {
    this.tipo = 'composto'
    this.atualizarTipo()
  },

  calcularConta() {
    if (!this.pronto) return
    var valor = paraNumero(this.textos[0])
    var parcelas = paraNumero(this.textos[1])
    var taxa = paraNumero(this.textos[2])
    var r = calcular(valor, parcelas, taxa, this.tipo)
    this.tituloResultado = this.tipo === 'simples' ? 'Juros simples' : 'Juros compostos'
    this.resumo1 = reais(valor) + ' em ' + parcelas + 'x'
    this.resumo2 = porcento(taxa) + ' ao mês'
    this.total = reais(r.montante)
    this.totalCls = 'total ' + tamanho(this.total, 12, 16)
    this.juros = reais(r.juros)
    this.parcela = parcelas + 'x de ' + reais(r.parcela)
    this.mostrar('resultado')
  },

  voltar() {
    this.mostrar('principal')
  },

  novaConta() {
    this.textos = ['', '', '']
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  // Gesto de voltar da banda: no teclado ou no resultado, volta para a tela principal em vez de
  // fechar o app e perder o que foi digitado; na tela principal, fecha o app. Mesmo padrão de uma
  // calculadora que já roda na Mi Band 10 (sempre retorna true e sai com this.$app.exit()).
  onBackPress() {
    if (this.telaPrincipal) {
      this.$app.exit()
    } else {
      this.mostrar('principal')
    }
    return true
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 40px 12px 44px 12px;
}

.tela {
  flex: 1;
  flex-direction: column;
}

.centro {
  align-items: center;
}

.espaco {
  flex: 1;
}

/* Tela principal */
.app {
  font-size: 15px;
  color: #8a8a8e;
  text-align: center;
  margin-bottom: 8px;
}

.barra {
  height: 72px;
  margin: 4px 0;
  padding: 0 14px;
  border-radius: 22px;
  flex-direction: column;
  justify-content: center;
  background-color: #1c1c1e;
}

.rotulo {
  font-size: 14px;
  color: #8a8a8e;
}

.valor {
  font-size: 22px;
  color: #ffffff;
}

.vazio {
  font-size: 16px;
  color: #5a5a5e;
}

.tipo {
  padding: 0 8px;
}

.rotuloTipo {
  font-size: 14px;
  color: #8a8a8e;
  padding-left: 6px;
  margin-bottom: 6px;
}

.seg {
  flex-direction: row;
}

.op {
  flex: 1;
  height: 36px;
  margin: 0 2px;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.sel {
  background-color: #ff9f0a;
}

.opTexto {
  font-size: 14px;
  color: #c7c7cc;
}

.opTextoSel {
  font-size: 14px;
  color: #000000;
  font-weight: bold;
}

.calcular {
  height: 52px;
  margin: 0 10px;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  background-color: #30d158;
}

.off {
  background-color: #2c2c2e;
}

.calcularTexto {
  font-size: 20px;
  color: #000000;
  font-weight: bold;
}

.calcularTextoOff {
  font-size: 20px;
  color: #5a5a5e;
  font-weight: bold;
}

/* Teclado */
.topo {
  height: 132px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 20px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 14px;
  text-align: center;
}

.grande { font-size: 30px; }
.medio { font-size: 24px; }
.pequeno { font-size: 18px; }

.dica {
  font-size: 13px;
  color: #8a8a8e;
  margin-top: 6px;
  text-align: center;
}

.erro {
  font-size: 13px;
  color: #ff453a;
  margin-top: 6px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }
.apagada { background-color: #000000; }

.rotuloTecla {
  font-size: 26px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 17px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 17px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.resumo {
  font-size: 13px;
  color: #c7c7cc;
  text-align: center;
}

.legenda {
  font-size: 14px;
  color: #8a8a8e;
  margin-top: 14px;
}

.total {
  color: #30d158;
  font-weight: bold;
  text-align: center;
}

.linhaValor {
  font-size: 20px;
  color: #ffffff;
  text-align: center;
}

.botoes {
  flex-direction: row;
  width: 100%;
  padding: 0 6px;
}

.botao {
  flex: 1;
  height: 52px;
  margin: 0 3px;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  background-color: #3a3a3c;
}

.verde { background-color: #30d158; }
</style>
