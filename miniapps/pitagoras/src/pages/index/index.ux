<template>
  <div class="page">
    <!-- Tela principal: os três lados. Só div/text/if/for, como no Juros e no Descontos. -->
    <div class="tela" if="{{telaPrincipal}}">
      <text class="cabecalho">a² + b² = c²</text>
      <div class="barra" onclick="abrirA">
        <text class="rotulo">Cateto a</text>
        <text class="{{aCls}}">{{aTexto}}</text>
      </div>
      <div class="barra" onclick="abrirB">
        <text class="rotulo">Cateto b</text>
        <text class="{{bCls}}">{{bTexto}}</text>
      </div>
      <div class="barra" onclick="abrirC">
        <text class="rotulo">Hipotenusa c</text>
        <text class="{{cCls}}">{{cTexto}}</text>
      </div>
      <div class="mensagens">
        <text class="{{mensagemCls}}">{{mensagem1}}</text>
        <text class="{{mensagemCls}}">{{mensagem2}}</text>
      </div>
      <div class="espaco"></div>
      <div class="{{calcularCls}}" onclick="calcularConta">
        <text class="{{calcularTextoCls}}">{{calcularTexto}}</text>
      </div>
    </div>

    <!-- Teclado: 0 a 9, X (o lado a descobrir), vírgula e apagar -->
    <div class="tela" if="{{telaTeclado}}">
      <div class="topo">
        <text class="titulo">{{titulo}}</text>
        <text class="{{digitadoCls}}">{{mostrado}}</text>
        <text class="{{avisoCls}}">{{aviso}}</text>
      </div>
      <div class="teclado">
        <div class="linha" for="{{linha in teclas}}">
          <div class="{{t.cls}}" for="{{t in linha}}" onclick="tocar(t.k)">
            <text class="rotuloTecla">{{t.t}}</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla xis" onclick="tocarX">
            <text class="rotuloTecla">X</text>
          </div>
          <div class="tecla fn" onclick="tocarVirgula">
            <text class="rotuloTecla">,</text>
          </div>
          <div class="tecla" onclick="tocarZero">
            <text class="rotuloTecla">0</text>
          </div>
          <div class="tecla fn" onclick="tocarApagar">
            <text class="rotuloTecla">⌫</text>
          </div>
        </div>
        <div class="linha">
          <div class="tecla nav" onclick="cancelar">
            <text class="rotuloNav">Voltar</text>
          </div>
          <div class="tecla ok" onclick="confirmar">
            <text class="rotuloOk">OK</text>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultado: cabe numa tela só -->
    <div class="tela centro" if="{{telaResultado}}">
      <text class="{{tituloResultadoCls}}">{{tituloResultado}}</text>
      <text class="formula">{{formula}}</text>
      <div class="espaco"></div>
      <text class="{{dado1Cls}}">{{dado1}}</text>
      <text class="{{dado2Cls}}">{{dado2}}</text>
      <text class="{{quadradoCls}}">{{quadrado}}</text>
      <div class="espaco"></div>
      <text class="legenda">{{legendaResposta}}</text>
      <text class="{{respostaCls}}">{{resposta}}</text>
      <div class="espaco"></div>
      <div class="botoes">
        <div class="botao cinza" onclick="voltar">
          <text class="textoBotaoClaro">Voltar</text>
        </div>
        <div class="botao verde" onclick="novaConta">
          <text class="textoBotaoEscuro">Nova</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { LADOS, calcular, descrever, digitar, mostrarLado, mostrarRascunho, validar } from '../../common/pitagoras.js'

// Só padrões do Juros e do Descontos, que já rodam na Mi Band 10: div/text com if e for,
// propriedades simples no template (sem índice de lista nem expressão), classes montadas aqui e
// funções de toque sem argumentos (menos o teclado numérico, igual ao Juros). Nada de list.

function k(t, key) {
  return { t: t, k: key, cls: 'tecla' }
}

var TECLAS = [
  [k('1', '1'), k('2', '2'), k('3', '3')],
  [k('4', '4'), k('5', '5'), k('6', '6')],
  [k('7', '7'), k('8', '8'), k('9', '9')]
]

// Maior letra (classe .fNN) em que o texto cabe em [largura] px. Cada caractere ocupa até
// ~0,62 da altura da letra (medido com uma fonte mais larga que a da banda, por segurança).
var FONTES = [40, 36, 32, 28, 24, 22, 20, 18, 16]
function fonte(texto, maximo, largura) {
  for (var i = 0; i < FONTES.length; i++) {
    var f = FONTES[i]
    if (f <= maximo && texto.length * f * 0.62 <= largura) return 'f' + f
  }
  return 'f16'
}

// Larguras úteis: tela 212 − 2×10 de margem; barras têm mais 2×12 por dentro.
var LARGURA_TELA = 192
var LARGURA_BARRA = 168

var VAZIO = 'Tocar aqui'
var DICA1 = 'Toque num lado,'
var DICA2 = 'X = o que falta'

// Texto e classe da barra de um lado: vazio, X (laranja) ou o número.
function barra(texto) {
  if (texto === '') return { t: VAZIO, c: 'vazio' }
  var t = mostrarLado(texto)
  return { t: t, c: (texto === 'X' ? 'valorX ' : 'valor ') + fonte(t, 32, LARGURA_BARRA) }
}

export default {
  private: {
    telaPrincipal: true,
    telaTeclado: false,
    telaResultado: false,
    // Textos confirmados de cada lado (a, b, c): '' = vazio, 'X' = o lado a descobrir.
    textos: ['', '', 'X'],
    aTexto: VAZIO,
    aCls: 'vazio',
    bTexto: VAZIO,
    bCls: 'vazio',
    cTexto: 'X',
    cCls: 'valorX f32',
    mensagem1: DICA1,
    mensagem2: DICA2,
    mensagemCls: 'dica f18',
    calcularCls: 'botaoGrande off',
    calcularTextoCls: 'textoBotaoOff',
    calcularTexto: 'Preencha tudo',
    // Teclado
    campo: 0,
    rascunho: '',
    titulo: '',
    mostrado: '0',
    digitadoCls: 'digitado f40',
    aviso: 'X para descobrir',
    avisoCls: 'dica f18',
    teclas: TECLAS,
    // Resultado
    tituloResultado: '',
    tituloResultadoCls: 'tituloResultado f24',
    formula: '',
    dado1: '',
    dado1Cls: 'dado f28',
    dado2: '',
    dado2Cls: 'dado f28',
    quadrado: '',
    quadradoCls: 'quadrado f20',
    legendaResposta: 'Resultado',
    resposta: '',
    respostaCls: 'resposta f40'
  },

  mostrar(tela) {
    this.telaPrincipal = tela === 'principal'
    this.telaTeclado = tela === 'teclado'
    this.telaResultado = tela === 'resultado'
  },

  // Redesenha as três barras e o botão Calcular a partir dos textos.
  atualizarPrincipal() {
    var t = this.textos
    var a = barra(t[0])
    var b = barra(t[1])
    var c = barra(t[2])
    this.aTexto = a.t
    this.aCls = a.c
    this.bTexto = b.t
    this.bCls = b.c
    this.cTexto = c.t
    this.cCls = c.c
    var vazio = t[0] === '' || t[1] === '' || t[2] === ''
    var semX = t[0] !== 'X' && t[1] !== 'X' && t[2] !== 'X'
    var pronto = !vazio && !semX
    this.calcularCls = pronto ? 'botaoGrande verde' : 'botaoGrande off'
    this.calcularTextoCls = pronto ? 'textoBotaoEscuro' : 'textoBotaoOff'
    this.calcularTexto = pronto ? 'Calcular' : vazio ? 'Preencha tudo' : 'Marque um X'
    this.mensagem1 = DICA1
    this.mensagem2 = DICA2
    this.mensagemCls = 'dica f18'
  },

  atualizarTeclado() {
    var texto = mostrarRascunho(this.rascunho)
    this.mostrado = texto
    this.digitadoCls = 'digitado ' + fonte(texto, 40, LARGURA_TELA)
  },

  mostrarAviso(erro) {
    this.aviso = erro ? erro : 'X para descobrir'
    this.avisoCls = (erro ? 'erro ' : 'dica ') + fonte(this.aviso, 18, LARGURA_TELA)
  },

  abrir(indice) {
    this.campo = indice
    this.rascunho = this.textos[indice]
    this.titulo = LADOS[indice].titulo
    this.mostrarAviso('')
    this.atualizarTeclado()
    this.mostrar('teclado')
  },

  abrirA() {
    this.abrir(0)
  },

  abrirB() {
    this.abrir(1)
  },

  abrirC() {
    this.abrir(2)
  },

  tocar(tecla) {
    if (tecla === '') return
    this.rascunho = digitar(this.rascunho, tecla, LADOS[this.campo])
    this.mostrarAviso('')
    this.atualizarTeclado()
  },

  tocarX() {
    this.tocar('X')
  },

  tocarVirgula() {
    this.tocar(',')
  },

  tocarZero() {
    this.tocar('0')
  },

  tocarApagar() {
    this.tocar('DEL')
  },

  confirmar() {
    var erro = validar(this.rascunho)
    if (erro) {
      this.mostrarAviso(erro)
      return
    }
    // Cópia da lista para a tela perceber a mudança. Só um lado pode ser o X: marcar um novo
    // X tira o anterior.
    var textos = this.textos.slice()
    if (this.rascunho === 'X') {
      for (var i = 0; i < textos.length; i++) {
        if (textos[i] === 'X') textos[i] = ''
      }
    }
    textos[this.campo] = this.rascunho
    this.textos = textos
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  cancelar() {
    this.mostrar('principal')
  },

  calcularConta() {
    var r = calcular(this.textos)
    if (r.erro) {
      // Mensagem curta de uma ou duas linhas (separadas por "|") no lugar da dica.
      var linhas = r.erro.split('|')
      this.mensagem1 = linhas[0]
      this.mensagem2 = linhas.length > 1 ? linhas[1] : ' '
      this.mensagemCls = 'erro f18'
      return
    }
    var d = descrever(r)
    this.tituloResultado = d.titulo
    this.tituloResultadoCls = 'tituloResultado ' + fonte(d.titulo, 24, LARGURA_TELA)
    this.formula = d.formula
    this.dado1 = d.dado1
    this.dado1Cls = 'dado ' + fonte(d.dado1, 28, LARGURA_TELA)
    this.dado2 = d.dado2
    this.dado2Cls = 'dado ' + fonte(d.dado2, 28, LARGURA_TELA)
    this.quadrado = d.quadrado
    this.quadradoCls = 'quadrado ' + fonte(d.quadrado, 20, LARGURA_TELA)
    this.legendaResposta = d.legenda
    this.resposta = d.resposta
    this.respostaCls = 'resposta ' + fonte(d.resposta, 40, LARGURA_TELA)
    this.mostrar('resultado')
  },

  // Volta para a tela principal com os números, para trocar um lado.
  voltar() {
    this.mostrar('principal')
  },

  // Limpa tudo; a hipotenusa volta a ser o X (o caso mais comum).
  novaConta() {
    this.textos = ['', '', 'X']
    this.atualizarPrincipal()
    this.mostrar('principal')
  },

  // Gesto de voltar da banda: teclado ou resultado → tela principal; na principal, fecha o app.
  // Mesmo padrão de uma calculadora que já roda na Mi Band 10 (sempre retorna true e sai com
  // this.$app.exit()).
  onBackPress() {
    if (this.telaPrincipal) {
      this.$app.exit()
    } else {
      this.mostrar('principal')
    }
    return true
  }
}
</script>

<style>
/* Letras grandes e tudo cabendo na tela (212 × 520), sem rolar. */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
  padding: 36px 10px 30px 10px;
}

.tela {
  flex: 1;
  flex-direction: column;
}

.centro {
  align-items: center;
}

.espaco {
  flex: 1;
}

.verde { background-color: #30d158; }
.cinza { background-color: #3a3a3c; }
.off { background-color: #2c2c2e; }

/* Tela principal */
.cabecalho {
  font-size: 22px;
  color: #8a8a8e;
  text-align: center;
  margin-bottom: 2px;
}

.barra {
  height: 86px;
  margin-top: 8px;
  padding: 0 12px;
  border-radius: 24px;
  flex-direction: column;
  justify-content: center;
  background-color: #1c1c1e;
}

.rotulo {
  font-size: 19px;
  color: #8a8a8e;
  margin-bottom: 2px;
}

.valor {
  color: #ffffff;
}

.valorX {
  color: #ff9f0a;
  font-weight: bold;
}

.vazio {
  font-size: 22px;
  color: #6e6e73;
}

.mensagens {
  margin-top: 8px;
  flex-direction: column;
  align-items: center;
}

.dica {
  color: #8a8a8e;
  text-align: center;
}

.erro {
  color: #ff453a;
  text-align: center;
}

.botaoGrande {
  height: 72px;
  border-radius: 36px;
  justify-content: center;
  align-items: center;
}

.textoBotaoEscuro {
  font-size: 26px;
  color: #000000;
  font-weight: bold;
}

.textoBotaoClaro {
  font-size: 24px;
  color: #ffffff;
}

.textoBotaoOff {
  font-size: 22px;
  color: #6e6e73;
}

/* Teclado */
.topo {
  height: 124px;
  flex-direction: column;
  align-items: center;
}

.titulo {
  font-size: 22px;
  color: #ff9f0a;
  text-align: center;
}

.digitado {
  color: #ffffff;
  margin-top: 8px;
  text-align: center;
}

.teclado {
  flex: 1;
  flex-direction: column;
}

.linha {
  flex: 1;
  flex-direction: row;
}

.tecla {
  flex: 1;
  margin: 3px;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  background-color: #2c2c2e;
}

.fn { background-color: #5a5a5e; }
.xis { background-color: #ff9f0a; }
.nav { background-color: #3a3a3c; }
.ok { background-color: #30d158; }

.rotuloTecla {
  font-size: 32px;
  color: #ffffff;
}

.rotuloNav {
  font-size: 19px;
  color: #ffffff;
}

.rotuloOk {
  font-size: 24px;
  color: #000000;
  font-weight: bold;
}

/* Resultado */
.tituloResultado {
  color: #ff9f0a;
  text-align: center;
}

.formula {
  font-size: 20px;
  color: #8a8a8e;
  text-align: center;
  margin-top: 4px;
}

.dado {
  color: #ffffff;
  text-align: center;
}

.quadrado {
  color: #c7c7cc;
  text-align: center;
  margin-top: 4px;
}

.legenda {
  font-size: 19px;
  color: #8a8a8e;
}

.resposta {
  color: #30d158;
  font-weight: bold;
  text-align: center;
  margin-top: 4px;
}

.botoes {
  flex-direction: row;
  width: 100%;
}

.botao {
  flex: 1;
  height: 64px;
  margin: 0 3px;
  border-radius: 32px;
  justify-content: center;
  align-items: center;
}

/* Tamanhos de letra escolhidos no script conforme o texto (função fonte). */
.f40 { font-size: 40px; }
.f36 { font-size: 36px; }
.f32 { font-size: 32px; }
.f28 { font-size: 28px; }
.f24 { font-size: 24px; }
.f22 { font-size: 22px; }
.f20 { font-size: 20px; }
.f18 { font-size: 18px; }
.f16 { font-size: 16px; }
</style>
